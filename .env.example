# NEXT LEAP 2.0 Environment Configuration
SECRET_KEY=nextleap-super-secret-dev-key-change-in-production-2026
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# Database Configuration
# Default: SQLite file database (nextleap.db) for zero-setup execution.
# To connect to MySQL, uncomment and configure:
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/nextleap_db

# Optional AI Integration (Leave empty to use built-in intelligent rule-based expert engine)
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=none
